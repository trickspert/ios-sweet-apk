+/* For the resync after a resume (bsd/dev/sweet_virtio.c): PL031 seconds, 0 without. */
+extern "C" uint32_t sweet_rtc_seconds(void);
+uint32_t
+sweet_rtc_seconds(void)
+{
+	return sweet_rtc != NULL ? sweet_rtc[PL031_DR / 4] : 0;
+}
