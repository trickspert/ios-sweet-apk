+class IONetworkStack : public IOService {
+	OSDeclareDefaultStructors(IONetworkStack);
+};
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+class IONetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject *properties)
+{
+	static uint32_t logged;
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSNumber *cmd = dict ? OSDynamicCast(OSNumber, dict->getObject("IONetworkStackUserCommand")) : NULL;
+	OSNumber *unit = dict ? OSDynamicCast(OSNumber, dict->getObject("IOInterfaceUnit")) : NULL;
+	if (logged < 8) {
+		logged++;
+		IOLog("SWEET NET: IONetworkStack naming request (command %u, unit %u) accepted; en0 is named by the kernel\n",
+		    cmd ? cmd->unsigned32BitValue() : 0, unit ? unit->unsigned32BitValue() : 0);
+	}
+	return kIOReturnSuccess;
+}
+
+static void
+sweet_net_publish_stack(void)
+{
+	IOService *resources = IOService::getResourceService();
+	IONetworkStack *stack = OSTypeAlloc(IONetworkStack);
+	if (resources == NULL || stack == NULL || !stack->init()) {
+		OSSafeReleaseNULL(stack);
+		IOLog("SWEET NET: IONetworkStack not created\n");
+		return;
+	}
+	stack->setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	if (stack->attach(resources)) {
+		stack->registerService();
+	}
+	stack->release();
+}
