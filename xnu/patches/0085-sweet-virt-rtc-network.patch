 	bsd_init_kprintf("calling inittodr\n");
diff --git a/iokit/Kernel/arm/SweetNet.cpp b/iokit/Kernel/arm/SweetNet.cpp
new file mode 100644
index 0000000..58cd522
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNet.cpp
@@ -0,0 +1,99 @@
+/*
+ * IOKit side of the sweet-virt Ethernet (bsd/dev/sweet_virtio.c, en0).
+ *
+ * The network stack itself needs no IOKit, but configd does: InterfaceNamer
+ * and SCNetworkInterface list network interfaces by matching IOKit objects
+ * of class IONetworkInterface whose IOService parent (the controller) has
+ * the MAC address; PreferencesMonitor then creates a DHCP service for each
+ * one and IPConfiguration runs DHCP on it. IONetworkingFamily is a kext that
+ * this kernel does not have, so the class names it would provide are
+ * defined here (empty: nothing calls into them) and one interface/controller
+ * pair is published with the properties configd reads:
+ *
+ *   interface  IOInterfaceType 6 (Ethernet), IOBuiltin, BSD Name "en0",
+ *              IOInterfaceNamePrefix "en", IOInterfaceUnit 0 (already named,
+ *              so InterfaceNamer does not try to name it through IONetworkStack)
+ *   controller IOMACAddress, IOFeatures
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBSD.h>
+#include <IOKit/IOPlatformExpert.h>
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController {
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class SweetVirtioNet : public IOEthernetController {
+	OSDeclareDefaultStructors(SweetVirtioNet);
+};
+OSDefineMetaClassAndStructors(SweetVirtioNet, IOEthernetController);
+
+extern "C" void sweet_net_publish(const uint8_t *mac, const char *prefix, uint32_t unit);
+
+void
+sweet_net_publish(const uint8_t *mac, const char *prefix, uint32_t unit)
+{
+	IOService *provider = IOService::getPlatform();
+	SweetVirtioNet *ctl = OSTypeAlloc(SweetVirtioNet);
+	IOEthernetInterface *nif = OSTypeAlloc(IOEthernetInterface);
+	char bsd[16];
+
+	if (provider == NULL || ctl == NULL || nif == NULL || !ctl->init() || !nif->init()) {
+		IOLog("SWEET NET: IOKit objects not created\n");
+		OSSafeReleaseNULL(ctl);
+		OSSafeReleaseNULL(nif);
+		return;
+	}
+	snprintf(bsd, sizeof(bsd), "%s%u", prefix, unit);
+
+	ctl->setProperty("IOMACAddress", (void *)mac, 6);
+	ctl->setProperty("IOFeatures", 0ULL, 32);
+	ctl->setProperty("IOVendor", "QEMU");
+	ctl->setProperty("IOModel", "virtio-net");
+	ctl->setProperty("IOLinkStatus", 3ULL, 32);            /* valid | active */
+	ctl->setProperty("IOLinkSpeed", 1000000000ULL, 64);
+	ctl->setProperty("IOMaxPacketSize", 1518ULL, 32);
+	ctl->setProperty("IOMinPacketSize", 64ULL, 32);
+
+	nif->setProperty("IOInterfaceType", 6ULL, 8);          /* IFT_ETHER */
+	nif->setProperty("IOBuiltin", true);
+	nif->setProperty("IOPrimaryInterface", true);
+	nif->setProperty(kIOBSDNameKey, bsd);
+	nif->setProperty("IOInterfaceNamePrefix", prefix);
+	nif->setProperty("IOInterfaceUnit", (unsigned long long)unit, 32);
+	nif->setProperty("IOLocation", "");
+	nif->setProperty("IOMaxTransferUnit", 1500ULL, 32);
+	nif->setProperty("IOMediaAddressLength", 6ULL, 32);
+	nif->setProperty("IOMediaHeaderLength", 14ULL, 32);
+
+	if (!ctl->attach(provider) || !nif->attach(ctl)) {
+		IOLog("SWEET NET: IOKit attach failed\n");
+	} else {
+		ctl->registerService();
+		nif->registerService();
+		IOLog("SWEET NET: %s published in IOKit (IOEthernetInterface)\n", bsd);
+	}
+	ctl->release();
+	nif->release();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..f7560d8 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -10,6 +10,41 @@
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
 
+extern "C" int sweet_virt_present(void);
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * Wall clock. QEMU's virt board has a PL031 RTC at 0x09010000 that counts
+ * UTC seconds from the host's clock: on sweet-virt it gives the boot time
+ * (otherwise 1 Jan 1970, shown as 31 Dec on the lock screen) and keeps
+ * settimeofday. The phone has no RTC driver yet: time stays 0 there.
+ */
+#define SWEET_PL031_PA          0x09010000
+#define PL031_DR                0x00            /* data: seconds */
+#define PL031_LR                0x08            /* load */
+static volatile uint32_t *sweet_rtc;
+
+static void
+sweet_rtc_probe(void)
+{
+	if (!sweet_virt_present()) {
+		return;
+	}
+	vm_offset_t r = ml_io_map(SWEET_PL031_PA, 0x1000);
+	if (r == 0) {
+		return;
+	}
+	volatile uint32_t *p = (volatile uint32_t *)r;
+	/* PrimeCell IDs: peripheral 0x31 0x10 (PL031), cell 0x0d 0xf0 0x05 0xb1 */
+	if ((p[0xfe0 / 4] & 0xff) != 0x31 || (p[0xfe4 / 4] & 0xff) != 0x10 ||
+	    (p[0xff0 / 4] & 0xff) != 0x0d || (p[0xffc / 4] & 0xff) != 0xb1) {
+		IOLog("SWEET RTC: no PL031 at 0x%x\n", SWEET_PL031_PA);
+		return;
+	}
+	sweet_rtc = p;
+	IOLog("SWEET RTC: PL031 at 0x%x, UTC %u\n", SWEET_PL031_PA, p[PL031_DR / 4]);
+}
+
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
 
@@ -18,6 +53,8 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
 };
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
@@ -31,9 +68,30 @@ SweetPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+	/*
+	 * IOKitInitializeTime() waits up to 30 s for an "IORTC" resource before
+	 * reading the clock; nothing else publishes one here. The time comes
+	 * from getGMTTimeOfDay() (0 without the PL031).
+	 */
+	sweet_rtc_probe();
+	publishResource("IORTC", this);
 	return true;
 }
 
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	return sweet_rtc != NULL ? (long)sweet_rtc[PL031_DR / 4] : 0;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	if (sweet_rtc != NULL && secs > 0) {
+		sweet_rtc[PL031_LR / 4] = (uint32_t)secs;
+	}
+}
+
 const char *
 SweetPlatformExpert::deleteList(void)
 {
