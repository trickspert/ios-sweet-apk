 void
 AppleCLCD::present(const uint8_t *rec)
 {
 	uint32_t mask = get32(rec, 0x104);
 
+	if (fScanout != NULL) {
+		/* One full-screen layer: show iOS's surface itself (no copy). */
+		uint32_t layers = 0, only = SWEET_FB_LAYERS;
+		for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+			if ((mask & (1u << layer)) && get32(rec, 0x54 + 4 * layer) != 0) {
+				layers++;
+				only = layer;
+			}
+		}
+		if (layers == 1) {
+			const uint8_t *a = rec + 0x64 + 16 * only;
+			const uint8_t *b = rec + 0xc4 + 16 * only;
+			SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * only));
+			bool full = get32(a, 0) == 0 && get32(a, 4) == 0 && get32(b, 0) == 0 && get32(b, 4) == 0 &&
+			    (get32(b, 8) == 0 || get32(b, 8) == fLogicalW) && (get32(b, 12) == 0 || get32(b, 12) == fLogicalH);
+			bool done = s != NULL && s != fSurface && full && scanoutSurface(s);
