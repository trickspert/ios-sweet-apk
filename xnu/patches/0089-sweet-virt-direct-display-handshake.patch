+/* Is the app reading frames (its counter at 0x38 changed within 1 s)? */
+bool
+AppleCLCD::scanoutAppReading(void)
+{
+	uint32_t ack = *(volatile uint32_t *)(fScanout + 0x38);
+	uint64_t now = mach_absolute_time(), second;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	if (ack != fScanAck) {
+		fScanAck = ack;
+		fScanAckTime = now;
+		if (!fScanAckLogged) {
+			fScanAckLogged = true;
+			IOLog("SWEET FB: direct display: the app reads frames from RAM\n");
+		}
+	}
+	return fScanAckTime != 0 && now - fScanAckTime < second;
+}
