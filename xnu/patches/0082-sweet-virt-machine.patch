+/*
+ * sweetfb_scale: show the surface rectangle (sx,sy) w x h, placed at logical
+ * (dx,dy), on a panel of 1/fScale size: every panel pixel takes the source
+ * pixel at its logical position.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	const int32_t k = (int32_t)fScale;
+	uintptr_t src = s->kernelAddress();
+
+	if (src == 0 || (s->bytesPerElement && s->bytesPerElement != 4) ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	/* Panel pixels p with dx <= p * k + fOffX < dx + w (same for y). */
+	int32_t px0 = dx - fOffX <= 0 ? 0 : (dx - fOffX + k - 1) / k;
+	int32_t px1 = dx + w - fOffX <= 0 ? 0 : (dx + w - fOffX + k - 1) / k;
+	int32_t py0 = dy - fOffY <= 0 ? 0 : (dy - fOffY + k - 1) / k;
+	int32_t py1 = dy + h - fOffY <= 0 ? 0 : (dy + h - fOffY + k - 1) / k;
+	px1 = px1 > (int32_t)fWidth ? (int32_t)fWidth : px1;
+	py1 = py1 > (int32_t)fHeight ? (int32_t)fHeight : py1;
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = py * k + fOffY - dy + sy;
+		const uint32_t *in = (const uint32_t *)(src + s->offset + (uint64_t)ly * s->bytesPerRow);
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		int32_t lx = px0 * k + fOffX - dx + sx;
+		for (int32_t px = px0; px < px1; px++, lx += k) {
+			out[px] = in[lx];
+		}
+	}
+}
