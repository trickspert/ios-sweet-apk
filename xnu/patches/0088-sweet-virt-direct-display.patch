+void
+AppleCLCD::scanoutPublish(uint32_t kind, uint32_t id, uint32_t w, uint32_t h, uint32_t bpr, uint32_t fmt,
+    uint64_t offset, uint64_t total, const uint64_t *runs, uint32_t nruns)
+{
+	volatile uint32_t *d32 = (volatile uint32_t *)fScanout;
+	volatile uint64_t *d64 = (volatile uint64_t *)fScanout;
+	uint32_t seq = fScanSeq + 1;    /* odd: being written */
+
+	d32[2] = seq;
+	__builtin_arm_dmb(0xf);
+	d32[3] = w;
+	d32[4] = h;
+	d32[5] = bpr;
+	d32[6] = fmt;
+	d32[7] = nruns;
+	d64[4] = offset;
+	d64[5] = total;
+	d32[12] = kind;
+	for (uint32_t i = 0; i < 2 * nruns; i++) {
+		d64[8 + i] = runs[i];
+	}
+	__builtin_arm_dmb(0xf);
+	fScanSeq = seq + 1;
+	d32[2] = fScanSeq;
+	fScanKind = kind;
+	fScanID = id;
+}
+
+void
+AppleCLCD::scanoutPanel(void)
+{
+	uint64_t run[2] = { fPhys, (uint64_t)fRowBytes * fHeight };
+	scanoutPublish(1, 0, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA, 0, run[1], run, 1);
+}
+
+/* Describe surface s in place; false if it cannot be (then it is copied). */
+bool
+AppleCLCD::scanoutSurface(SweetSurface *s)
+{
+	if (s->memory == NULL || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    (s->bytesPerElement && s->bytesPerElement != 4) || s->pixelFormat != SWEET_FB_FORMAT_BGRA ||
+	    s->width != fLogicalW || s->height != fLogicalH || s->bytesPerRow < s->width * 4 ||
+	    (uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height > s->memory->getLength()) {
+		return false;
+	}
+	if (fScanKind == 2 && fScanID == s->id) {
+		/* Same buffer again: only the sequence moves (the app re-reads it). */
+		volatile uint32_t *d32 = (volatile uint32_t *)fScanout;
+		d32[2] = fScanSeq + 1;
+		__builtin_arm_dmb(0xf);
+		fScanSeq += 2;
+		d32[2] = fScanSeq;
+		return true;
+	}
+	uint32_t slot = SWEET_SCANOUT_CACHE;
+	for (uint32_t i = 0; i < SWEET_SCANOUT_CACHE; i++) {
+		if (fScanCache[i].id == s->id && fScanCache[i].runs != NULL) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == SWEET_SCANOUT_CACHE) {
+		slot = fScanNext++ % SWEET_SCANOUT_CACHE;
+		if (fScanCache[slot].runs == NULL) {
+			fScanCache[slot].runs = (uint64_t *)IOMallocData(SWEET_SCANOUT_MAX_RUNS * 2 * sizeof(uint64_t));
+			if (fScanCache[slot].runs == NULL) {
+				return false;
+			}
+		}
+		/* Physically contiguous pieces of the surface memory. */
+		uint64_t *runs = fScanCache[slot].runs;
+		uint64_t len = s->memory->getLength(), off = 0;
+		uint32_t n = 0;
+		fScanCache[slot].id = 0;
+		while (off < len) {
+			IOByteCount seg = 0;
+			addr64_t pa = s->memory->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+			if (pa == 0 || seg == 0) {
+				return false;
+			}
+			if (seg > len - off) {
+				seg = len - off;
+			}
+			if (n > 0 && runs[2 * (n - 1)] + runs[2 * (n - 1) + 1] == pa) {
+				runs[2 * (n - 1) + 1] += seg;
+			} else {
+				if (n == SWEET_SCANOUT_MAX_RUNS) {
+					return false;
+				}
+				runs[2 * n] = pa;
+				runs[2 * n + 1] = seg;
+				n++;
+			}
+			off += seg;
+		}
+		fScanCache[slot].id = s->id;
+		fScanCache[slot].n = n;
+		if (fScanLogged < 8) {
+			fScanLogged++;
+			IOLog("SWEET FB: direct display: surface %u %ux%u bpr %u in %u piece(s)\n",
+			    s->id, s->width, s->height, s->bytesPerRow, n);
+		}
+	}
+	scanoutPublish(2, s->id, s->width, s->height, s->bytesPerRow, s->pixelFormat, s->offset,
+	    s->memory->getLength(), fScanCache[slot].runs, fScanCache[slot].n);
+	return true;
+}
