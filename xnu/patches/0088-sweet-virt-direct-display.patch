+/*
+ * Direct display (boot-arg sweetfb_scanout=1, sweet-virt with QEMU's guest
+ * RAM in a memfd the Android app maps): instead of copying each frame into
+ * the panel, the kernel describes where the frame is in guest physical
+ * memory and the app reads it straight from RAM and scales it on the
+ * phone's GPU. The descriptor sits in the reserved framebuffer region,
+ * 0x1600000 bytes after the panel (VirtAdt.FB .. FB + FB_SIZE):
+ *
+ *   0x00 u32 magic 'S16D'    0x04 u32 version 1
+ *   0x08 u32 seq: odd while being written, read again after copying
+ *   0x0c u32 width  0x10 u32 height  0x14 u32 bytes per row
+ *   0x18 u32 pixel format ('BGRA')   0x1c u32 number of runs
+ *   0x20 u64 byte offset of pixel (0,0) in the runs   0x28 u64 total bytes
+ *   0x30 u32 kind: 1 = the panel (the copied frame), 2 = iOS's own surface
+ *   0x40 runs: { u64 physical address, u64 length } x number of runs
+ *
+ * A single full-screen layer (what backboardd presents) is shown in place
+ * (kind 2, no copy at all: more CPU for iOS, every frame, full 1125x2436);
+ * anything else is copied to the panel as before and described as kind 1.
+ */
+#define SWEET_SCANOUT_OFFSET            0x1600000
+#define SWEET_SCANOUT_SIZE              0x100000
+#define SWEET_SCANOUT_MAGIC             0x44363153      /* 'S16D' */
+#define SWEET_SCANOUT_MAX_RUNS          4096
+#define SWEET_SCANOUT_CACHE             4
+
 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
 #define SWEET_FB_FORMAT_BGRA            0x42475241
